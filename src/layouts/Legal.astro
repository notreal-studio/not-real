---
import "../styles/global.css";
import { languages, langName, localePath, type Lang } from "../i18n/utils";

interface Props { lang: Lang; title: string; desc: string; paths: Record<string, string>; }
const { lang, title, desc, paths } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = (Astro.site?.href ?? "").replace(/\/$/, "");
const canonical = `${site}${paths[lang]}`;
const other = languages.find((l) => l !== lang) as Lang;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <script is:inline>
    (function(){
      var saved = localStorage.getItem('theme');
      var theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  {languages.map((l) => (
    <link rel="alternate" hreflang={l} href={`${site}${paths[l]}`} />
  ))}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <script is:inline src={`${base}consent.js`}></script>
</head>
<body>
  <div class="legal-top">
    <a class="brand" href={localePath(lang, base)}><span>Not</span><em>Real</em></a>
    <div class="lang"><a href={paths[other]}>{langName[other]}</a></div>
  </div>
  <main class="legal">
    <slot />
  </main>
</body>
</html>
