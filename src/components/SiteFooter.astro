---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props { lang: Lang; home?: string; }
const { lang, home = "" } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="wrap foot">
    <div class="foot-grid">
      <div>
        <div class="foot-word" role="img" aria-label="Not Real">Not<em>Real</em></div>
        <span class="foot-tag">{t("footer.tag")}</span>
      </div>
      <div class="foot-col">
        <div class="foot-h">{t("footer.explore")}</div>
        <a href={`${home}#darbai`}>{t("menu.portfolio")}</a>
        <a href={`${home}#paslaugos`}>{t("menu.services")}</a>
        <a href={`${home}#faq`}>{t("menu.faq")}</a>
        <a href={`${home}#kontaktai`}>{t("menu.contact")}</a>
      </div>
      <div class="foot-col">
        <div class="foot-h">{t("footer.hi")}</div>
        <a class="plain" href="mailto:inga.bankauske@gmail.com">inga.bankauske@gmail.com</a>
        <a class="plain" href="https://www.instagram.com/notreal.inga/" target="_blank" rel="noopener">Instagram</a>
        <a class="plain" href="https://www.linkedin.com/in/ingabankauske" target="_blank" rel="noopener">LinkedIn</a>
        <a class="plain" href="https://t.me/ingaBank" target="_blank" rel="noopener">Telegram</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{t("footer.copy")}</span>
      <span class="foot-legal">
        <a href={lang === "lt" ? `${base}lt/privatumas/` : `${base}privacy/`}>{t("footer.privacy")}</a>
        <button type="button" data-cookie-settings>{t("footer.cookies")}</button>
      </span>
    </div>
  </div>
</footer>
