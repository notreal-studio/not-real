---
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import Lightbox from "./Lightbox.astro";
import { useTranslations, localePath, type Lang } from "../i18n/utils";
import { about } from "../data/about";
import { heroVideos, groups, mosaicPool, mosaicLayouts, homeLb, introIndex, introVideo } from "../data/portfolio";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.replace(/\/$/, "");
const groupHref = (slug: string) => (lang === "lt" ? base + "/lt" : base) + "/work/" + slug + "/";
const countLabel = (g: (typeof groups)[number]) => g.countLabel?.[lang] ?? `${g.items.length} ${t("pf.works")}`;

---
<Base lang={lang}>
  <div id="loader" class="tex-bordeaux" aria-hidden="true">
    <span class="logo logo-lockup"></span>
    <div class="lc"><span id="lcount">0</span> — {t("loader.loading")}</div>
    <div class="lbar" id="lbar"></div>
  </div>

  <SiteHeader lang={lang} />

  <main id="top">
    {/* ---------- HERO: full-screen video reel ---------- */}
    <section class="hero-slider" aria-roledescription="carousel" aria-label={t("hero.sr")}>
      <h1 class="sr-only">{t("hero.sr")}</h1>
      {heroVideos.map((w, n) => (
        <article class={`hs${w.vertical ? " is-v" : ""}${n === 0 ? " is-active" : ""}`} aria-roledescription="slide" aria-label={`${n + 1} / ${heroVideos.length}: ${w.title}`}>
          {w.vertical && <div class="hs-bg" data-bg={`${base}/assets/video/${w.slug}.webp`} style={n === 0 ? `background-image:url(${base}/assets/video/${w.slug}.webp)` : undefined}></div>}
          {n === 0 && <img class="hs-poster" src={`${base}/assets/video/${w.slug}.webp`} alt="" fetchpriority="high" decoding="async" />}
          <video muted playsinline preload="metadata" poster={n === 0 ? `${base}/assets/video/${w.slug}.webp` : undefined} data-poster={`${base}/assets/video/${w.slug}.webp`} data-src={`${base}/assets/video/${w.slug}.mp4`}></video>
          <div class="hs-cap">
            <div class="hs-tag">{t("hero.tag")}</div>
            <div class="hs-title">{w.title}</div>
            <div class="hs-sub">{w.sub[lang]}</div>
          </div>
        </article>
      ))}
      <div class="hero-scrim"></div>
      <div class="hs-ctrl">
        <button type="button" class="hs-prev" aria-label={t("hero.prev")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <span class="hs-count" aria-live="off">01 / {String(heroVideos.length).padStart(2, "0")}</span>
        <button type="button" class="hs-next" aria-label={t("hero.next")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        <button type="button" class="hs-sound" aria-label={t("hero.sound")} aria-pressed="false">
          <svg class="i-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M17 9l4 6M21 9l-4 6"/></svg>
          <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
        </button>
      </div>
      <div class="hs-progress"><i></i></div>
    </section>

    {/* ---------- PORTFOLIO: one living mosaic that contains the five group tiles ---------- */}
    <section class="block portfolio" id="darbai">
      <div class="wrap">
        <div class="kicker reveal">{t("pf.kicker")}</div>
        <h2 class="statement reveal" set:html={t("pf.h2")}></h2>
        <p class="lead reveal">{t("pf.lead")}</p>
      </div>

      <div class="wrap">
        <nav class="lm-nav" aria-label={t("pf.kicker")}>
          {groups.map((g, i) => (
            <a class="lm-l" href={groupHref(g.slug)} data-g={i}><span class="lm-ln">{g.n}</span>{g.title[lang]}</a>
          ))}
        </nav>
        <div class="lm" role="region" aria-label={t("pf.marquee")} data-layouts={JSON.stringify(mosaicLayouts)} data-pool={mosaicPool.length}>
          {groups.map((g, i) => (
            <a class="lm-t lm-g" href={groupHref(g.slug)} data-g={i} style={`--x:${mosaicLayouts[0][i][0]};--y:${mosaicLayouts[0][i][1]};--w:${mosaicLayouts[0][i][2]};--h:${mosaicLayouts[0][i][3]}`}>
              <span class="lm-in">
                <span class="lm-slides" aria-hidden="true">
                  {g.slides.map((s, k) => (<img src={`${base}${s}`} alt="" loading={k === 0 ? "eager" : "lazy"} decoding="async" class={k === 0 ? "is-on" : undefined} />))}
                </span>
                <span class="lm-gc">
                  <span>
                    <span class="lm-gn">{g.n}</span>
                    <span class="lm-gt">{g.title[lang]}</span>
                    <span class="lm-gs">{g.cardSub[lang]} · {countLabel(g)}</span>
                  </span>
                  <span class="lm-ga" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                </span>
              </span>
            </a>
          ))}
          {mosaicPool.slice(0, 7).map((m, k) => (
            <button type="button" class={`lm-t lm-p${m.kind === "video" ? " is-video" : ""}`} data-lb={k} aria-label={m.title[lang]} style={`--x:${mosaicLayouts[0][5 + k][0]};--y:${mosaicLayouts[0][5 + k][1]};--w:${mosaicLayouts[0][5 + k][2]};--h:${mosaicLayouts[0][5 + k][3]}`}>
              <span class="lm-in">
                <img src={`${base}${m.cover}`} alt="" loading="eager" decoding="async" />
                <span class="play" aria-hidden="true"></span>
              </span>
            </button>
          ))}
        </div>
      </div>    </section>

    {/* ---------- ABOUT ---------- */}
    <section class="block about" id="about">
      <div class="wrap about-grid">
        <div class="reveal">
          <div class="polaroid about-polaroid">
            <div class="vid-wrap">
              <video class="about-vid" muted loop playsinline preload="none" poster={`${base}${introVideo.cover}`} data-src={`${base}${introVideo.video?.src}`}></video>
              <button type="button" class="vid-open" data-lb={introIndex} aria-label={`${t("pf.open")}: ${introVideo.title[lang]}`}>
                <span class="vid-hint">{t("about.hint")}</span>
              </button>
            </div>
            <div class="pc">{about.caption[lang]}</div>
          </div>
        </div>
        <div>
          <div class="kicker reveal">{about.kicker[lang]}</div>
          <h2 class="statement reveal" set:html={about.h2[lang]}></h2>
          {about.p.map((p, i) => (<p class={`about-p reveal${i === 0 ? " first" : ""}`}>{p[lang]}</p>))}
          <dl class="about-facts reveal">
            {about.facts.map((f) => (<div><dt>{f.k[lang]}</dt><dd>{f.v[lang]}</dd></div>))}
          </dl>
          <a class="btn reveal" href="#kontaktai">{about.cta[lang]}</a>
        </div>
      </div>
    </section>

    {/* ---------- FAQ ---------- */}
    <section class="block faq" id="faq">
      <div class="wrap">
        <div class="kicker reveal">{t("faq.kicker")}</div>
        <h2 class="statement reveal" set:html={t("faq.h2")}></h2>
        <div class="faq-list">
          {[1, 2, 3, 4, 5, 6].map((n) => (
            <details class="faq-item reveal">
              <summary>{t(`faq.${n}_q`)}</summary>
              <p>{t(`faq.${n}_a`)}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- LOOK TWICE. THEN SAY HI. ---------- */}
    <section class="cta tex-bordeaux">
      <div class="wrap">
        <h2 class="reveal" set:html={t("cta.h2")}></h2>
        <p class="reveal">{t("cta.p")}</p>
        <a class="btn reveal" href="#kontaktai">{t("cta.btn")}</a>
      </div>
    </section>

    {/* ---------- KEEP IN TOUCH ---------- */}
    <section class="block" id="kontaktai">
      <div class="wrap">
        <div class="kicker reveal">{t("contact.kicker")}</div>
        <div class="contact-shell">
          <div class="reveal">
            <h2 class="statement" set:html={t("contact.h2")}></h2>
            <p class="lead">{t("contact.lead")}</p>
            <div class="c-links">
              <a href="mailto:inga.bankauske@gmail.com">inga.bankauske@gmail.com</a>
              <a href="https://www.instagram.com/notreal.inga/" target="_blank" rel="noopener">Instagram</a>
              <a href="https://www.linkedin.com/in/ingabankauske" target="_blank" rel="noopener">LinkedIn</a>
              <a href="https://t.me/ingaBank" target="_blank" rel="noopener">Telegram</a>
            </div>
            <a class="btn ghost c-book" href="#kontaktai" data-booking>{t("contact.book")}</a>
          </div>
          <form id="contact-form" class="reveal">
            <input type="hidden" name="access_key" value="714c67de-3c23-4adc-ab9c-320426630d8a" />
            <input type="hidden" name="subject" value={t("form.subject")} />
            <input type="hidden" name="from_name" value={t("form.from")} />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-label="Leave this empty" />
            <label for="name">{t("form.name_label")}</label>
            <input id="name" name="name" type="text" placeholder={t("form.name_ph")} required />
            <label for="email">{t("form.email_label")}</label>
            <input id="email" name="email" type="email" placeholder={t("form.email_ph")} required />
            <label for="message">{t("form.msg_label")}</label>
            <textarea id="message" name="message" placeholder={t("form.msg_ph")} required></textarea>
            <button class="btn" type="submit">{t("form.submit")}</button>
            <div class="form-msg" id="form-msg" role="status"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
  <Lightbox lang={lang} items={homeLb} />
</Base>
