---
import CaseLayout from "../layouts/CaseLayout.astro";
import { soxi } from "../data/soxi";
import { gallery, soxiFrames } from "../data/gallery";
import type { Lang } from "../i18n/utils";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = soxi[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const u = (p: string) => `${base}${p}`;
const paths = { en: `${base}/work/soxi/`, lt: `${base}/lt/work/soxi/` };

const all = [...Object.values(gallery).flat(), ...soxiFrames];
const im = (id: string) => {
  const m = all.find((x) => x.src.includes(`/${id}.webp`));
  if (!m) throw new Error("SOXI image not found: " + id);
  return m;
};
const caseImg = (name: string, w: number, h: number) => ({ src: `/assets/img/soxi-case/${name}.webp`, thumb: `/assets/img/soxi-case/${name}.webp`, w, h });
const space = caseImg("space", 952, 748);
const guidelines = caseImg("guidelines", 1257, 610);

const hero = im("04_hero");
const frameIds = soxiFrames.map((f) => f.src.split("/").pop()!.replace(".webp", ""));
const eshop = ["p057", "p058", "p059", "p061", "p062", "p063", "p064", "p104"].map(im);
const posters = gallery.soxiPosters;
const scenes = ["p067", "p065", "p017", "03_rolled-dress"].map(im);
const four = ["p073", "p069", "p070", "p068"].map(im);
const sheets = ["p072", "p071"].map(im);
// small + large version of each photo so phones do not download the 1600 px file for a 160 px tile
const rs = (m: { src: string; thumb: string; w: number }) => (m.thumb !== m.src ? `${u(m.thumb)} 640w, ${u(m.src)} ${Math.min(m.w, 1600)}w` : undefined);
const SZ = "(max-width: 980px) 48vw, 24vw";
const alt = (n: string, i: number) => `SOXI — ${n} ${i + 1}`;
---
<CaseLayout lang={lang} title={c.metaTitle} desc={c.metaDesc} paths={paths} backLabel={c.back} ogImage="/assets/img/soxi-case/og.jpg">

  <header class="case-hero">
    <div class="wrap case-hero-grid">
      <div>
        <div class="case-kicker">{c.kicker}</div>
        <h1 class="case-h1">SOXI</h1>
        <p class="case-tag">{c.tagline}</p>
        <dl class="case-facts">
          {c.facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </div>
      <figure class="case-hero-fig">
        <img src={u(hero.src)} srcset={rs(hero)} sizes="(max-width: 980px) 85vw, 36vw" width={hero.w} height={hero.h} alt="SOXI — the Omakase box, six rolled socks" fetchpriority="high" />
      </figure>
    </div>
  </header>

  <section class="case-steps">
    <div class="wrap">
      <div class="case-kicker">{c.stepsTitle}</div>
      <ol class="steps">
        {c.steps.map(([n, h, p]) => (<li><b>{n}</b><span class="steps-h">{h}</span><span class="steps-p">{p}</span></li>))}
      </ol>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap case-two">
      <div>
        <div class="case-num">{c.s1.n}</div>
        <h2>{c.s1.h}</h2>
        {c.s1.p.map((t) => (<p>{t}</p>))}
        <ul class="case-tags">{c.s1.tags.map((t) => (<li>{t}</li>))}</ul>
      </div>
      <div class="case-duo">
        {[im("01_roll-into-socks"), im("06_six-rolls")].map((m, i) => (
          <figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("idea", i)} loading="lazy" /></figure>
        ))}
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap case-two">
      <div>
        <div class="case-num">{c.s2.n}</div>
        <h2>{c.s2.h}</h2>
        <p>{c.s2.p}</p>
        <blockquote class="case-quote"><span>{c.s2.qLabel}</span>“{c.s2.q}”</blockquote>
      </div>
      <figure>
        <img src={u(guidelines.src)} width={guidelines.w} height={guidelines.h} alt="SOXI brand guidelines, six pages" loading="lazy" />
        <figcaption>{c.s2.cap}</figcaption>
      </figure>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap">
      <div class="case-num">{c.s3.n}</div>
      <h2>{c.s3.h}</h2>
      <div class="case-two">
        <div>
          {c.s3.p.map((t) => (<p>{t}</p>))}
          <div class="case-tip"><b>{c.s3.tipH}</b>{c.s3.tip}</div>
        </div>
        <div class="case-duo">
          {[im("p062"), im("p104")].map((m, i) => (
            <figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("product", i)} loading="lazy" /></figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap">
      <div class="case-num">{c.s4.n}</div>
      <h2>{c.s4.h}</h2>
      <div class="case-two">
        <div>
          {c.s4.p.map((t) => (<p>{t}</p>))}
          <table class="case-table">
            <thead><tr><th>{c.s4.th[0]}</th><th>{c.s4.th[1]}</th></tr></thead>
            <tbody>{c.s4.rows.map(([a, b]) => (<tr><td>{a}</td><td>{b}</td></tr>))}</tbody>
          </table>
        </div>
        <figure>
          <img src={u(space.src)} width={space.w} height={space.h} alt="The SOXI Space in Magnific One, zoomed out" loading="lazy" />
          <figcaption>{c.s4.cap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap">
      <div class="case-num">{c.s5.n}</div>
      <h2>{c.s5.h}</h2>
      <div class="case-cols">
        {c.s5.cols.map(([h, p, k]) => (
          <div class="case-col">
            {k === "logo" && <img src={u(im("02_logo").src)} width={im("02_logo").w} height={im("02_logo").h} alt="SOXI logo" loading="lazy" />}
            {k === "colour" && <img src={u(im("07_colour").src)} width={im("07_colour").w} height={im("07_colour").h} alt="SOXI colour card" loading="lazy" />}
            {k === "type" && <div class="case-type"><span>Roll into socks.</span><small>DM Serif Display · Inter</small></div>}
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap">
      <div class="case-num">{c.s6.n}</div>
      <h2>{c.s6.h}</h2>
      <div class="case-two">
        <div>
          <p>{c.s6.p}</p>
          <div class="case-tip"><b>{c.s6.ruleH}</b>{c.s6.rule}</div>
        </div>
        <div class="case-duo">
          {sheets.map((m, i) => (
            <figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("character sheet", i)} loading="lazy" /></figure>
          ))}
        </div>
      </div>
      <h3 class="case-sub">{c.s6.fourH}</h3>
      <p class="case-lead">{c.s6.four}</p>
      <div class="case-quad">
        {four.map((m, i) => (<figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("character", i)} loading="lazy" /></figure>))}
      </div>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap">
      <div class="case-num">{c.s7.n}</div>
      <h2>{c.s7.h}</h2>
      <p class="case-lead">{c.s7.p}</p>
      <div class="case-quad">
        {scenes.map((m, i) => (<figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("scene", i)} loading="lazy" /></figure>))}
      </div>
      <div class="case-notes">
        {c.s7.notes.map(([h, p]) => (<div><b>{h}</b><span>{p}</span></div>))}
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap">
      <div class="case-num">{c.s8.n}</div>
      <h2>{c.s8.h}</h2>
      <ul class="case-lines">{c.s8.lines.map((t) => (<li>{t}</li>))}</ul>
      <div class="case-two">{c.s8.p.map((t) => (<p>{t}</p>))}</div>
      <div class="case-posters">
        {posters.map((m, i) => (<figure><img src={u(m.src)} srcset={rs(m)} sizes={SZ} width={m.w} height={m.h} alt={alt("poster", i)} loading="lazy" /></figure>))}
      </div>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap">
      <div class="case-num">{c.s9.n}</div>
      <h2>{c.s9.h}</h2>
      <p class="case-lead">{c.s9.p}</p>
      <div class="case-eshop">
        {eshop.map((m, i) => (<figure><img src={u(m.thumb)} width={m.w} height={m.h} alt={alt("e-shop", i)} loading="lazy" /></figure>))}
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap case-two">
      <div>
        <div class="case-num">{c.s10.n}</div>
        <h2>{c.s10.h}</h2>
        <p>{c.s10.p}</p>
        <table class="case-table">
          <thead><tr><th>{c.s10.th[0]}</th><th>{c.s10.th[1]}</th></tr></thead>
          <tbody>{c.s10.rows.map(([a, b]) => (<tr><td>{a}</td><td>{b}</td></tr>))}</tbody>
        </table>
      </div>
      <figure class="case-video">
        <video controls playsinline preload="none" poster={u("/assets/video/soxi-film.webp")} src={u("/assets/video/soxi-film.mp4")}></video>
      </figure>
    </div>
  </section>

  <section class="case-sec">
    <div class="wrap">
      <h2>{c.result}</h2>
      <div class="case-eight">
        {frameIds.map((id, i) => { const m = im(id); return (<figure><img src={u(m.thumb)} width={m.w} height={m.h} alt={alt("frame", i)} loading="lazy" /></figure>); })}
      </div>
    </div>
  </section>

  <section class="case-sec case-alt">
    <div class="wrap">
      <h2>{c.more.h}</h2>
      <div class="case-more">
        {c.more.items.map(([h, p]) => (<div><b>{h}</b><span>{p}</span></div>))}
      </div>
    </div>
  </section>

  <section class="case-cta">
    <div class="wrap">
      <h2>{c.cta.h}</h2>
      <p>{c.cta.p}</p>
      <div class="case-cta-b">
        <a class="hero-cta" href={`${lang === "lt" ? base + "/lt/" : base + "/"}#kontaktai`}>{c.cta.book}</a>
        <a class="case-ghost" href={`${lang === "lt" ? base + "/lt/" : base + "/"}#darbai`}>{c.cta.work}</a>
      </div>
    </div>
  </section>
</CaseLayout>
