---
import CaseLayout from "../layouts/CaseLayout.astro";
import BrandStory from "./BrandStory.astro";
import VisualAutomation from "./VisualAutomation.astro";
import { soxiStory, nrStory, mediaOf, bookOf } from "../data/brandstory";
import { groups, soxiCover } from "../data/portfolio";
import { useTranslations, localePath, type Lang } from "../i18n/utils";

interface Props { lang: Lang; slug: string; sub?: "soxi" | "notreal"; }
const { lang, slug, sub } = Astro.props;
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL;
const base = baseUrl.replace(/\/$/, "");
const prefix = lang === "lt" ? base + "/lt" : base;
const home = localePath(lang, baseUrl);
const g = groups.find((x) => x.slug === slug)!;
const subSlug = sub === "soxi" ? "soxi" : sub === "notreal" ? "not-real" : "";
const tail = subSlug ? subSlug + "/" : "";
const paths = { en: base + "/work/" + slug + "/" + tail, lt: base + "/lt/work/" + slug + "/" + tail };
const soxiHref = `${prefix}/work/soxi/`;
const indexed = g.items.map((m, i) => ({ m, i }));
const nr = indexed.filter(({ m }) => m.id.startsWith("nr-"));
const sx = indexed.filter(({ m }) => m.id.startsWith("sx-"));
const isBrand = slug === "brand-identity";
const useOrb = slug === "video" || slug === "photography" || slug === "graphic-design";
const showSoxi = false;
const isVA = slug === "visual-automation";
const nrItems = nr.map(({ m }) => m);
const st = sub === "soxi" ? soxiStory : sub === "notreal" ? nrStory : null;
const lbList = !isBrand ? g.items : st ? [...mediaOf(st), ...bookOf(st)] : undefined;   // brand pages: the story pictures, then the whole brandbook (its own lightbox group); the chooser needs none
const subName = sub === "soxi" ? "SOXI" : sub === "notreal" ? "NOT REAL" : "";
const nrCover = nrItems[0];
const introParas = g.intro[lang].split("\n\n");
const introFlat = introParas.join(" ");
const descBase = st ? st.lead[lang] : introFlat;
const desc = descBase.length > 155 ? descBase.slice(0, 152).replace(/\s+\S*$/, "") + "…" : descBase;
---
<CaseLayout lang={lang} title={`${subName || g.title[lang]} — Not Real`} desc={desc} paths={paths} mainClass="gp" lbItems={lbList}>
  <section class={sub ? "gp-hero gp-sub" : "gp-hero"}>
    <div class="wrap">
      {sub ? (
        <a class="gp-back" href={`${prefix}/work/${slug}/`}>← {g.title[lang]}</a>
      ) : (
        <a class="gp-back" href={`${home}#darbai`}>← {t("gp.back")}</a>
      )}
      <div class="gp-n">{g.n} / 05</div>
      <h1 class="gp-h1"><span class="br-ul">{subName || g.title[lang]}</span></h1>
      {!sub && introParas.map((para) => (<p class={introFlat.length > 650 ? "gp-intro long" : "gp-intro"}>{para}</p>))}
      <div class="gp-meta"><span>{t("gp.by")}</span></div>
      <nav class="gp-tabs" aria-label={t("pf.kicker")}>
        {groups.map((x) => (
          <a href={`${prefix}/work/${x.slug}/`} aria-current={x.slug === slug ? "page" : undefined}><span class="gp-tn">{x.n}</span>{x.title[lang]}</a>
        ))}
      </nav>
      {isBrand && (
        <nav class="gp-subtabs" aria-label={g.title[lang]}>
          <a href={`${prefix}/work/${slug}/soxi/`} aria-current={sub === "soxi" ? "page" : undefined}>SOXI</a>
          <a href={`${prefix}/work/${slug}/not-real/`} aria-current={sub === "notreal" ? "page" : undefined}>NOT REAL</a>
        </nav>
      )}
    </div>
  </section>

  {showSoxi && (
    <section class="gp-sec">
      <div class="wrap">
        <div class="gp-feature">
          <a href={soxiHref} aria-label={t("gp.soxi.h")}><img src={`${base}${soxiCover.thumb}`} width={soxiCover.w} height={soxiCover.h} alt="SOXI" loading="lazy" /></a>
          <div>
            <div class="label" style="color:var(--accent);margin-bottom:14px">{t("gp.soxi.win")}</div>
            <h2>{t("gp.soxi.h")}</h2>
            <p>{t("gp.soxi.p")}</p>
            <a class="btn" href={soxiHref}>{t("gp.soxi.btn")}</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {isBrand && !sub ? (
    <section class="gp-sec">
      <div class="wrap">
        <div class="gp-choose">
          <a class="gp-choice" href={`${prefix}/work/${slug}/soxi/`}>
            <span class="gp-choice-img"><img src={`${base}${soxiCover.thumb}`} width={soxiCover.w} height={soxiCover.h} alt="" loading="eager" decoding="async" /></span>
            <span class="gp-choice-t">SOXI</span>
            <span class="gp-choice-d">{t("gp.sub.soxi.d")}</span>
            <span class="gp-choice-go">{t("gp.sub.open")} →</span>
          </a>
          <a class="gp-choice" href={`${prefix}/work/${slug}/not-real/`}>
            <span class="gp-choice-img"><img src={`${base}${nrCover.cover}`} width="640" height={Math.round(640 / nrCover.ratio)} alt="" loading="eager" decoding="async" /></span>
            <span class="gp-choice-t">NOT REAL</span>
            <span class="gp-choice-d">{t("gp.sub.nr.d")}</span>
            <span class="gp-choice-go">{t("gp.sub.open")} →</span>
          </a>
        </div>
      </div>
    </section>
  ) : st ? (
    <BrandStory lang={lang} base={base} offset={0} st={st} />
  ) : isVA ? (
    <VisualAutomation lang={lang} base={base} items={g.items} soxiHref={soxiHref} />
  ) : (
    <section class="gp-sec">
      <div class="wrap">
        <div class="gp-grid" data-orb={useOrb ? t("pf.sphere") : undefined}>
          {indexed.map(({ m, i }) => (
            <button type="button" class="gp-card" data-lb={i} aria-haspopup="dialog" aria-label={m.title[lang]}>
              <div class="gp-media" style={`aspect-ratio:${m.ratio.toFixed(4)}`}>
                <img src={`${base}${m.cover}`} alt="" loading={i < 6 ? "eager" : "lazy"} decoding="async" />
                {m.kind === "video" && <span class="gp-play" aria-hidden="true"></span>}
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="gp-cta tex-bordeaux">
    <div class="wrap">
      <h2>{t("gp.cta.h")}</h2>
      <a class="btn" href={`${home}#kontaktai`}>{t("gp.cta.btn")}</a>
    </div>
  </section>

  <section class="gp-other">
    <div class="wrap">
      <h2>{t("gp.more")}</h2>
      <div class="gp-links">
        {groups.filter((x) => x.slug !== slug).map((x) => (<a href={`${prefix}/work/${x.slug}/`}>{x.title[lang]}</a>))}
      </div>
    </div>
  </section>
</CaseLayout>
