---
// The SOXI brand-identity story on the Brand identity page: text and pictures in the order they should be seen.
import { story, storyIds, findImg, type Block } from "../data/brandstory";
import type { Lang } from "../i18n/utils";

interface Props { lang: Lang; base: string; offset: number; }
const { lang, base, offset } = Astro.props;
const idx = (id: string) => offset + storyIds.indexOf(id);
const logo = findImg("02_logo");
const heroImg = findImg(story.hero);
const pairs = (b: Block) => b.ids.reduce<string[][]>((a, id, i) => { if (i % 2 === 0) a.push([id]); else a[a.length - 1].push(id); return a; }, []);
---
<section class="gp-sec bs" aria-labelledby="bs-h">
  <div class="wrap">
    <div class="bs-head">
      <h2 id="bs-h" class="bs-title">{story.h[lang]}</h2>
      <p class="bs-lead">{story.lead[lang]}</p>
      <p class="bs-win">{story.win[lang]}</p>
    </div>
    <button type="button" class="bs-fig bs-hero" data-lb={idx(story.hero)} aria-haspopup="dialog" aria-label="SOXI">
      <img src={`${base}${heroImg.src}`} width={heroImg.w} height={heroImg.h} alt="" loading="eager" decoding="async" />
    </button>

    {story.sections.map((s) => (
      <article class="bs-sec">
        <header class="bs-sh"><span class="bs-n">{s.n}</span><h3>{s.h[lang]}</h3></header>
        <div class="bs-txt">{s.p.map((para) => (<p>{para[lang]}</p>))}</div>
        {s.blocks.map((b) => (
          b.type === "seq" ? (
            <figure class="bs-seq">
              <div class="bs-seqrow">
                {b.ids.map((id, i) => (
                  <>
                    {i > 0 && <span class="bs-arr" aria-hidden="true">→</span>}
                    {id === "@spiral" ? (
                      <div class="bs-fig bs-spiral" style={`--r:${(logo.h / logo.w).toFixed(4)}`} aria-hidden="true">
                        <img src={`${base}${logo.src}`} alt="" loading="lazy" decoding="async" />
                      </div>
                    ) : (
                      <button type="button" class="bs-fig" data-lb={idx(id)} aria-haspopup="dialog" aria-label="SOXI">
                        <img src={`${base}${findImg(id).thumb}`} width={findImg(id).w} height={findImg(id).h} alt="" loading="lazy" decoding="async" />
                      </button>
                    )}
                  </>
                ))}
              </div>
              {b.cap && <figcaption>{b.cap[lang]}</figcaption>}
            </figure>
          ) : b.type === "bb" ? (
            <div class="bs-bb">
              {pairs(b).map((pr) => (
                <div class="bs-bbrow">
                  {pr.map((id) => (
                    <button type="button" class="bs-fig" data-lb={idx(id)} aria-haspopup="dialog" aria-label="SOXI">
                      <img src={`${base}${findImg(id).thumb}`} width={findImg(id).w} height={findImg(id).h} alt="" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              ))}
            </div>
          ) : (
            <div class={`bs-row bs-${b.type}`}>
              {b.ids.map((id) => (
                <button type="button" class="bs-fig" data-lb={idx(id)} aria-haspopup="dialog" aria-label="SOXI">
                  <img src={`${base}${findImg(id).thumb}`} width={findImg(id).w} height={findImg(id).h} alt="" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          )
        ))}
      </article>
    ))}
    <p class="bs-credit">{story.credit[lang]}</p>
  </div>
</section>
